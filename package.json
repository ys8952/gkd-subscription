{
  "name": "hongguo-gkd-subscription",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "simple-git-hooks",
    "format": "prettier --cache --write --ignore-unknown .",
    "lint": "eslint --cache --fix .",
    "check": "tsc --noEmit && tsx ./scripts/check.ts",
    "build": "tsc --noEmit && tsx ./scripts/build.ts",
    "verify": "tsc --noEmit && tsx ./scripts/verify-ad-text.ts",
    "verify:published": "tsx ./scripts/verify-published.ts",
    "export": "tsx ./scripts/export-phone-file.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "NODE_OPTIONS=--experimental-strip-types npx --yes pnpm@11.20.0 exec lint-staged",
    "pre-push": "npx --yes pnpm@11.20.0 run check"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,jsx,tsx}": [
      "eslint --cache --fix"
    ],
    "*.json": [
      "prettier --cache --write"
    ]
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@gkd-kit/api": "0.9.3",
    "@gkd-kit/define": "0.0.1",
    "@gkd-kit/tools": "0.8.0",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "jiti": "2.7.0",
    "json5": "2.2.3",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  },
  "devDependencies": {
    "@gkd-kit/selector": "0.6.1",
    "regex-wasm": "0.1.1"
  }
}
